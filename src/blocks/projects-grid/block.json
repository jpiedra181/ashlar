{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ashlar/projects-grid",
    "version": "1.0.0",
    "title": "All projects",
    "category": "ashlar",
    "description": "Every project, filled in automatically: filters by category, newest or oldest first, the latest project in large and a grid of cards with “Load more”.",
    "keywords": ["projects", "portfolio", "grid", "work", "filter"],
    "textdomain": "ashlar",
    "attributes": {
        "align": { "type": "string", "default": "full" },
        "showFilters": { "type": "boolean", "default": true },
        "showCounts": { "type": "boolean", "default": true },
        "allLabel": { "type": "string", "default": "All" },
        "filtersLabel": { "type": "string", "default": "Filter projects by type of job" },
        "sortLabel": { "type": "string", "default": "Sort" },
        "newestLabel": { "type": "string", "default": "Newest first" },
        "oldestLabel": { "type": "string", "default": "Oldest first" },
        "showFeatured": { "type": "boolean", "default": true },
        "featuredId": { "type": "number", "default": 0 },
        "featuredTag": { "type": "string", "default": "Latest project" },
        "featuredButton": { "type": "string", "default": "Read the project" },
        "perPage": { "type": "number", "default": 10 },
        "step": { "type": "number", "default": 12 },
        "showingFormat": { "type": "string", "default": "Showing {shown} of {total}" },
        "moreFormat": { "type": "string", "default": "Load {n} more" },
        "emptyText": { "type": "string", "default": "No projects of this type yet." }
    },
    "supports": { "html": false, "align": ["full"], "anchor": true, "multiple": false },
    "example": { "viewportWidth": 1440 },
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "render": "file:./render.php"
}
