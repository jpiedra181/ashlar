{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ashlar/projects-carousel",
    "version": "1.0.0",
    "title": "Selected work",
    "category": "ashlar",
    "description": "Horizontal carousel with the projects marked “Show on the home page”, ending in a “View all projects” card. Projects are added in the Projects menu.",
    "keywords": ["projects", "carousel", "selected work", "portfolio", "slider"],
    "textdomain": "ashlar",
    "attributes": {
        "align": { "type": "string", "default": "full" },
        "theme": { "type": "string", "enum": ["light", "subtle", "dark"], "default": "light" },
        "chapterNum": { "type": "string", "default": "" },
        "chapterLabel": { "type": "string", "default": "Selected work" },
        "title": { "type": "string", "default": "Recent builds,<br>by street." },
        "hint": { "type": "string", "default": "Scroll or drag →" },
        "prevLabel": { "type": "string", "default": "Previous projects" },
        "nextLabel": { "type": "string", "default": "Next projects" },
        "trackLabel": { "type": "string", "default": "Selected projects" },
        "endEyebrow": { "type": "string", "default": "Since 2009" },
        "endCount": { "type": "string", "default": "118" },
        "endText": { "type": "string", "default": "houses, every one listed with its street, how long it took and what it finally cost." },
        "endLabel": { "type": "string", "default": "View all projects" },
        "endUrl": { "type": "string", "default": "/projects/" },
        "limit": { "type": "number", "default": 4 },
        "preview": { "type": "string", "default": "" }
    },
    "supports": { "html": false, "align": ["full"], "anchor": true },
    "example": { "viewportWidth": 1440 },
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "render": "file:./render.php"
}
