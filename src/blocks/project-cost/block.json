{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ashlar/project-cost",
    "version": "1.0.0",
    "title": "Project · The money",
    "category": "ashlar",
    "description": "Where the money went: a bar split by item, the list with percentages and amounts, and the fixed price, client changes and final account worked out for you.",
